{
    "crons": [
        {
            "path": "/api/cron/daily-report",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/cron/weekly-report",
            "schedule": "0 0 * * 6"
        }
    ],
    "functions": {
        "app/api/cron/daily-report/route.ts": {
            "maxDuration": 60
        }
    }
}